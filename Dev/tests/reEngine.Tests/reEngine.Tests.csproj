<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(ReEngineTestAutomation)' == 'true'">
    <DefineConstants>$(DefineConstants);REENGINE_ENABLE_AUTOMATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\reEngine.Core\reEngine.Core.csproj" />
    <ProjectReference Include="..\..\src\reEngine.Host\reEngine.Host.csproj" />
    <ProjectReference Include="..\..\src\reEngine.Installer\reEngine.Installer.csproj" />
    <Reference Include="Foundation.Core">
      <HintPath>..\..\lib\Foundation.Core.dll</HintPath>
    </Reference>
    <Reference Include="Foundation.Installer">
      <HintPath>..\..\lib\Foundation.Installer.dll</HintPath>
    </Reference>
    <Reference Include="Foundation.Retro">
      <HintPath>..\..\lib\Foundation.Retro.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug' Or '$(ReEngineTestAutomation)' == 'true'">
    <Reference Include="Foundation.Automation">
      <HintPath>..\..\lib\Foundation.Automation.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\reEngine.Launcher\LauncherArgsHelper.cs" Link="Linked\LauncherArgsHelper.cs" />
    <Compile Include="..\..\src\reEngine.Launcher\LauncherJobObjectGuard.cs" Link="Linked\LauncherJobObjectGuard.cs" />
    <Compile Include="..\..\src\reEngine.App\DemoCartSessionHelper.cs" Link="Linked\DemoCartSessionHelper.cs" />
    <Compile Include="..\..\src\reEngine.App\Program.Bootstrap.cs" Link="Linked\Program.Bootstrap.cs" />
    <Compile Include="..\..\src\reEngine.App\Program.Verify.cs" Link="Linked\Program.Verify.cs" />
    <Compile Include="..\..\src\reEngine.App\SettingsMigrationHelper.cs" Link="Linked\SettingsMigrationHelper.cs" />
    <Compile Include="..\..\src\reEngine.App\RecompLaunchOptions.cs" Link="Linked\RecompLaunchOptions.cs" />
    <Compile Include="..\..\src\reEngine.App\RecompLaunchOptionParser.cs" Link="Linked\RecompLaunchOptionParser.cs" />
    <Compile Include="..\..\src\reEngine.App\RecompLaunchFlagRouter.cs" Link="Linked\RecompLaunchFlagRouter.cs" />
    <Compile Include="..\..\src\reEngine.App\RecompLaunchPlanBuilder.cs" Link="Linked\RecompLaunchPlanBuilder.cs" />
    <Compile Include="..\..\src\reEngine.App\GracefulProcessTreeShutdown.cs" Link="Linked\GracefulProcessTreeShutdown.cs" />
    <Compile Include="..\..\src\reEngine.App\RecompLaunchCoordinator.cs" Link="Linked\RecompLaunchCoordinator.cs" />
    <Compile Include="..\..\src\reEngine.App\ReEngineAppStatusHelper.cs" Link="Linked\ReEngineAppStatusHelper.cs" />
    <Compile Include="..\..\src\reEngine.App\Ui\ReEngineTheme.cs" Link="Linked\ReEngineTheme.cs" />
    <Compile Include="..\..\src\reEngine.App\Ui\LibraryDisplayAudioPanel.cs" Link="Linked\LibraryDisplayAudioPanel.cs" />
    <Compile Include="..\..\src\reEngine.App\Ui\LibraryShelfPanel.cs" Link="Linked\LibraryShelfPanel.cs" />
    <Compile Include="..\..\src\reEngine.App\Ui\DetailsRightDrawer.cs" Link="Linked\DetailsRightDrawer.cs" />
    <Compile Include="..\..\src\reEngine.App\Ui\BringUpShelfPanel.cs" Link="Linked\BringUpShelfPanel.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
